<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.java-learn-prepare</string>
  <!-- 一個 job 依序跑每日與每週備稿（run_slot.sh），不是兩個 job 各排同一個整點：
       同時觸發會搶 ../java-learn-state 的 git index.lock。
       備的都是「下一次要寄的內容」，寄出交給雲端。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-s</string>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/run_slot.sh</string>
  </array>
  <!-- 開機/登入就補產一次（你打開電腦時就把明天的備好）。 -->
  <key>RunAtLoad</key><true/>
  <!-- 12:00 是唯一有 pmset 定時 FullWake 撐腰的班（由 ai-news-digest 的 install.sh 設定，
       全機只有一組重複喚醒，兩個專案共用）；13:00 是補救班。
       刻意不排晚班——最後一班太晚的話，失敗了也沒時間補救。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- 網路設定一變（接上 WiFi / 熱點、換網路）就再跑一次。
       固定班會漏：7/27 機器「醒著且有網路」的時間是 12:04–12:29，兩個固定班都沒踩進去。
       備的是明天要寄的課，所以晚上補到也有效，時間窗開到 23:00（見 run_slot.sh）。
       launchd 不會讓同一個 Label 同時跑兩份，所以不必另外上鎖。 -->
  <key>WatchPaths</key>
  <array>
    <string>/Library/Preferences/SystemConfiguration</string>
    <string>/var/run/resolv.conf</string>
  </array>

  <!-- 網路設定在切換過程會連續改好幾次，限制最快 3 分鐘才能再啟動一次。 -->
  <key>ThrottleInterval</key>
  <integer>180</integer>
  <key>StandardOutPath</key><string>__PROJECT_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__PROJECT_DIR__/launchd.err.log</string>
</dict>
</plist>
